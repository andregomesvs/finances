APP_URL="http://localhost:3000"
AUTH_SECRET="gere-um-segredo-forte-com-32-caracteres"

# Identidade Google autorizada a acessar o sistema.
FIREBASE_ALLOWED_EMAIL="seu-email@gmail.com"

# Configuração pública do aplicativo Web no Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Identificador exibido em Firebase Console > Configurações do projeto.
FIREBASE_PROJECT_ID="seu-projeto-firebase"

# Produção/local real: prefira apontar para um JSON mantido fora do repositório.
GOOGLE_APPLICATION_CREDENTIALS=""

# Alternativa para provedores que aceitam somente variáveis de ambiente.
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Desenvolvimento local com Firebase Emulator Suite.
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# Processamento server-side de documentos e análises de investimentos.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
